<Window x:Class="LibraryApp.Views.BookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книга"
        Width="480" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock x:Name="TxtWindowTitle" Text="Добавление книги"
                       FontSize="16" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Название -->
                <TextBlock Text="Название книги *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtTitle" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <!-- Автор -->
                <TextBlock Text="Автор *" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="CmbAuthor" Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="FullName" Margin="0,0,0,14"/>

                <!-- Жанр -->
                <TextBlock Text="Жанр *" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="CmbGenre" Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="Name" Margin="0,0,0,14"/>

                <!-- Год и Количество -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Год издания *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtYear" Style="{StaticResource ModernTextBox}"
                                 ToolTip="Например: 2023"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Количество в наличии *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtQuantity" Style="{StaticResource ModernTextBox}"
                                 ToolTip="Количество экземпляров"/>
                    </StackPanel>
                </Grid>

                <!-- ISBN -->
                <TextBlock Text="ISBN" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtISBN" Style="{StaticResource ModernTextBox}"
                         ToolTip="Например: 978-5-17-090000-1" Margin="0,0,0,8"/>

                <TextBlock Text="* — обязательные поля" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Content="💾 Сохранить" Style="{StaticResource PrimaryButton}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
