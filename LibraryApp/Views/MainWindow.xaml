<Window x:Class="LibraryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📚 Библиотека — Управление книгами"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Filter panel -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="32"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📚" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Управление библиотекой" FontSize="18" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock x:Name="TxtBookCount" Text="Загрузка..." FontSize="12"
                                   Foreground="#BBDEFB"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <WrapPanel Margin="16,10" Orientation="Horizontal">
                <Button Content="➕ Добавить книгу" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="BtnAddBook_Click"/>
                <Button Content="✏️ Редактировать" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="BtnEditBook_Click"/>
                <Button Content="🗑️ Удалить" Style="{StaticResource DangerButton}"
                        Margin="0,0,24,0" Click="BtnDeleteBook_Click"/>
                <Separator Width="1" Background="#E0E0E0" Margin="0,0,24,0"/>
                <Button Content="👤 Авторы" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="BtnManageAuthors_Click"/>
                <Button Content="🏷️ Жанры" Style="{StaticResource SecondaryButton}"
                        Click="BtnManageGenres_Click"/>
            </WrapPanel>
        </Border>

        <!-- ===== FILTER PANEL ===== -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск по названию -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Поиск по названию" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBox}"
                             TextChanged="TxtSearch_TextChanged"
                             ToolTip="Введите название книги для поиска"/>
                </StackPanel>

                <!-- Фильтр по жанру -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="🏷️ Жанр" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CmbGenreFilter" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="Name"
                              SelectionChanged="Filter_Changed"
                              ToolTip="Фильтр по жанру"/>
                </StackPanel>

                <!-- Фильтр по автору -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="👤 Автор" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CmbAuthorFilter" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="FullName"
                              SelectionChanged="Filter_Changed"
                              ToolTip="Фильтр по автору"/>
                </StackPanel>

                <!-- Сброс фильтров -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="✖ Сбросить" Style="{StaticResource SecondaryButton}"
                            Click="BtnClearFilters_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== DATAGRID ===== -->
        <DataGrid x:Name="BooksGrid"
                  Grid.Row="3"
                  Margin="12"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowBackground="White"
                  AlternatingRowBackground="#F8F9FA"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE"
                  ColumnHeaderHeight="42"
                  RowHeight="40"
                  FontSize="13"
                  MouseDoubleClick="BooksGrid_MouseDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                <DataGridTextColumn Header="Название книги" Binding="{Binding Title}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author.FullName}" Width="180"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre.Name}" Width="130"/>
                <DataGridTextColumn Header="Год" Binding="{Binding PublishYear}" Width="70"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="150"/>
                <DataGridTemplateColumn Header="В наличии" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuantityInStock}" Value="0">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding QuantityInStock}" FontWeight="Bold"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuantityInStock}" Value="0">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== STATUS BAR ===== -->
        <StatusBar Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Готово"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
